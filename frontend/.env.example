# frontend/.env.example
# Your confirmed real deployed backends:
VITE_API_URL=https://farmhub-p2p6.onrender.com/api
VITE_ANALYTICS_URL=https://farm-zsny.onrender.com/api/analytics

VITE_FIREBASE_API_KEY=xxxx
VITE_FIREBASE_AUTH_DOMAIN=farmhub-c057b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=farmhub-c057b
VITE_FIREBASE_STORAGE_BUCKET=farmhub-c057b.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx

# --- Important: these are baked in at BUILD time, not read at runtime ---
# Vite inlines every VITE_* value into the JS bundle when you run
# `npm run build`. Changing this file (or a GitHub Actions secret with the
# same name) does nothing to what's already live — you have to rebuild and
# redeploy for a new value to take effect. This is almost certainly why the
# CORS errors happened: the API URL baked into the live bundle was pointing
# at a service name (farmhub-api.onrender.com) that was never real.
