# backend/.env.example
PORT=8080
NODE_ENV=production

# Your confirmed live frontend origins — both the primary domain and the
# .firebaseapp.com alias, since Firebase Hosting serves both and either can
# show up as the browser's Origin header. Comma-separated, no spaces needed
# (the app trims each one). Add http://localhost:5173 back in for local dev.
CORS_ORIGIN=https://farmhub-c057b.web.app,https://farmhub-c057b.firebaseapp.com

# Firebase service account (from Project Settings > Service Accounts > Generate new key)
# On Render, upload that JSON as a Secret File and set
# SERVICE_ACCOUNT_KEY=/etc/secrets/farmhub.json. The API prefers that file.
# SERVICE_ACCOUNT_KEY=/etc/secrets/farmhub.json
FIREBASE_PROJECT_ID=farmhub-c057b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@farmhub-c057b.iam.gserviceaccount.com
# Keep the \n escapes when pasting the private key into a single-line env var
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- Where this actually needs to be set ---
# This .env file is for local dev only. On Render, set these same keys as
# environment variables on the farmhub-api service (dashboard name "farmhub",
# https://farmhub-p2p6.onrender.com) — Render restarts the service
# automatically when you save an env var there, no separate redeploy step.
