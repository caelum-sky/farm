APP_NAME=FarmBridge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://farmbridge.example.com
ASSET_URL=
CORS_ALLOWED_ORIGINS=https://farmbridge.example.com
ADMIN_PASSWORD=change-this-before-deploy
ADMIN_ALLOWED_IPS=
API_TOKEN_TTL_MINUTES=1440
TRUSTED_IMAGE_HOSTS=farmbridge.example.com
WEBHOOK_REQUIRE_SIGNATURES=true

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=farmbridge
DB_USERNAME=farmbridge
DB_PASSWORD=change-this-database-password
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE=default

FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

MAIL_MAILER=log
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=support@farmbridge.example.com
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SECRET=
COURIER_WEBHOOK_SECRET=
KYC_WEBHOOK_SECRET=
MANUAL_WEBHOOK_SECRET=
TWILIO_FROM=
